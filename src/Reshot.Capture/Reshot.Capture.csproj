<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinRT projection TFM: 22621 exposes GraphicsCaptureSession.IsBorderRequired /
         GraphicsCaptureAccess (Win11) to hide the yellow capture border. Min OS stays
         at 19041 (Win10 2004) via SupportedOSPlatformVersion; newer APIs are OS-guarded. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Reshot.Capture</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reshot.Core\Reshot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- D3D11 device + staging-texture readback for WGC frames. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

</Project>
