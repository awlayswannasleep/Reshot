<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Matches Reshot.Capture's WinRT TFM so the project reference is clean. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled only for the tray NotifyIcon + runtime icon drawing. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Reshot.App</RootNamespace>
    <AssemblyName>reshot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\reshot.ico</ApplicationIcon>
    <!-- DPI awareness is declared in app.manifest (WPF-first app; WinForms is only
         used for the tray NotifyIcon). Suppress the WinForms high-DPI analyzer. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reshot.Core\Reshot.Core.csproj" />
    <ProjectReference Include="..\Reshot.Capture\Reshot.Capture.csproj" />
    <ProjectReference Include="..\Reshot.Recording\Reshot.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SKElement host for the live editor canvas (pulls SkiaSharp transitively). -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon, also embedded as a WPF resource for the window + tray icon. -->
    <Resource Include="Assets\reshot.ico" />
  </ItemGroup>

</Project>
