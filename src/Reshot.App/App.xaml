<Application x:Class="Reshot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Reshot.App"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: Reshot is a tray app with no main window. The overlay
         (Phase 1) is constructed lazily on first capture, per ARCHITECTURE §7. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared Source VGUI styles. Every entry is keyed, so merging this
                     restyles nothing on its own; a window opts in per control. -->
                <ResourceDictionary Source="Theme/SourceVgui.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
