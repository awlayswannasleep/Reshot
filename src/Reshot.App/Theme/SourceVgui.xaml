<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Half-Life 2 / Source VGUI vocabulary shared by Reshot's WPF dialogs.

        Every colour here is the reference value from the settings window's stylesheet
        (src/reshot-tauri/src/styles.css), which in turn ports
        github.com/arlagonix/half-life-screen verbatim; the accent is Reshot teal where
        HL2 used orange. Keeping one copy in WPF means a dialog cannot quietly drift
        away from the settings window it is supposed to match.

        The default WPF templates are replaced outright rather than recoloured: their
        chrome draws its own border, its own hover wash and a focus rectangle, none of
        which exist in Source. That is what made an unstyled button look pasted on.
    -->

    <SolidColorBrush x:Key="VguiPanel" Color="#D9767676" />
    <SolidColorBrush x:Key="VguiText" Color="White" />
    <SolidColorBrush x:Key="VguiAccent" Color="#3C9898" />

    <!-- Horizontal rule: dark line over light line, the Source engraved groove. -->
    <SolidColorBrush x:Key="VguiRuleDark" Color="#434343" />
    <SolidColorBrush x:Key="VguiRuleLight" Color="#BBBABA" />

    <!-- Raised button bevel. -->
    <SolidColorBrush x:Key="VguiButtonBg" Color="#7B7B7B" />
    <SolidColorBrush x:Key="VguiButtonLight" Color="#BBBBBB" />
    <SolidColorBrush x:Key="VguiButtonDark" Color="#454545" />

    <!-- Inset checkbox bevel: the opposite lighting of a button, so it reads as a well. -->
    <SolidColorBrush x:Key="VguiCheckBg" Color="#555555" />
    <SolidColorBrush x:Key="VguiCheckDark" Color="#424343" />
    <SolidColorBrush x:Key="VguiCheckLight" Color="#BABABA" />

    <!--
        Dialog button. Source only ever gave it one state change — pressing inverts the
        bevel so the face appears to sink — so there is deliberately no hover wash here.
        FocusVisualStyle is null because WPF's dotted focus rectangle is the one piece of
        chrome the template cannot suppress on its own.
    -->
    <Style x:Key="VguiDialogButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource VguiText}" />
        <Setter Property="FontFamily" Value="Roboto, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- WPF cannot colour border sides individually, so each bevel is
                         two nested Borders: light top-left over dark bottom-right. -->
                    <Border x:Name="Outer"
                            Background="{StaticResource VguiButtonBg}"
                            BorderThickness="1,1,0,0"
                            BorderBrush="{StaticResource VguiButtonLight}">
                        <Border x:Name="Inner"
                                BorderThickness="0,0,1,1"
                                BorderBrush="{StaticResource VguiButtonDark}">
                            <ContentPresenter Margin="10,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource VguiButtonDark}" />
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource VguiButtonLight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- The reference greys a dead button by darkening the label,
                                 not by fading the whole control. -->
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close (×) glyph in a dialog titlebar: no frame, a faint dark wash on hover. -->
    <Style x:Key="VguiCloseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource VguiText}" />
        <Setter Property="FontFamily" Value="Roboto, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Wash" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Background" Value="#26000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Checkbox: a 12x12 sunken well and a hand-drawn tick, the same geometry the
        settings window draws as an inline SVG. The label sits 8px to its right.
    -->
    <Style x:Key="VguiCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource VguiText}" />
        <Setter Property="FontFamily" Value="Roboto, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent background so the whole row, label included, is a
                         click target rather than just the 12px box. -->
                    <Border Background="Transparent" Padding="0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="12" Height="12"
                                    Background="{StaticResource VguiCheckBg}"
                                    BorderThickness="1,1,0,0"
                                    BorderBrush="{StaticResource VguiCheckDark}">
                                <Border BorderThickness="0,0,1,1"
                                        BorderBrush="{StaticResource VguiCheckLight}">
                                    <Path x:Name="Tick"
                                          Visibility="Collapsed"
                                          Stretch="Uniform"
                                          Margin="1"
                                          Stroke="{StaticResource VguiText}"
                                          StrokeThickness="2"
                                          Data="M 1,2.5 L 3,5 L 7,1" />
                                </Border>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- A track that was never captured: still readable, plainly
                                 not in play. Matches .checkboxWrapper.disabled. -->
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The stylesheet's <hr>: one dark line, one light line, no margins of its own. -->
    <Style x:Key="VguiSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <StackPanel>
                        <Border Height="1" Background="{StaticResource VguiRuleDark}" />
                        <Border Height="1" Background="{StaticResource VguiRuleLight}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog titlebar caption: small, bold, upper case, exactly like .header. -->
    <Style x:Key="VguiDialogTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VguiText}" />
        <Setter Property="FontFamily" Value="Roboto, Segoe UI" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Body copy inside a dialog. -->
    <Style x:Key="VguiBody" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VguiText}" />
        <Setter Property="FontFamily" Value="Roboto, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
