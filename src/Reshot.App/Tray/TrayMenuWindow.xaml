<Window x:Class="Reshot.App.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="reshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Roboto, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <!--
        Same Half-Life 2 / Source VGUI vocabulary as the settings window
        (src/reshot-tauri/src/styles.css), so the tray menu and the settings
        dialog read as one product. Values come from the reference SCSS at
        github.com/arlagonix/half-life-screen; the accent is reshot teal where
        HL2 used orange.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelTint" Color="#D9767676" />
        <SolidColorBrush x:Key="BtnBg" Color="#7B7B7B" />
        <SolidColorBrush x:Key="BevelLight" Color="#BBBBBB" />
        <SolidColorBrush x:Key="BevelDark" Color="#454545" />
        <SolidColorBrush x:Key="Accent" Color="#3C9898" />
        <SolidColorBrush x:Key="CheckBg" Color="#555555" />
        <SolidColorBrush x:Key="CheckDark" Color="#424343" />
        <SolidColorBrush x:Key="CheckLight" Color="#BABABA" />
        <SolidColorBrush x:Key="RuleDark" Color="#434343" />
        <SolidColorBrush x:Key="RuleLight" Color="#BBBABA" />

        <!--
            Raised bevel: light top/left, dark bottom/right. WPF cannot colour
            border sides individually, so the two edges are two nested Borders.
            Pressing inverts them, exactly as the reference Button does.
        -->
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                BorderThickness="1,1,0,0"
                                BorderBrush="{StaticResource BevelLight}"
                                Background="{StaticResource BtnBg}">
                            <Border x:Name="Inner"
                                    BorderThickness="0,0,1,1"
                                    BorderBrush="{StaticResource BevelDark}">
                                <ContentPresenter Margin="6,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inset bevel + white tick, matching the reference Checkbox. -->
        <Style x:Key="MenuCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" Padding="6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="12" Height="12"
                                        BorderThickness="1,1,0,0"
                                        BorderBrush="{StaticResource CheckDark}"
                                        Background="{StaticResource CheckBg}">
                                    <Border BorderThickness="0,0,1,1"
                                            BorderBrush="{StaticResource CheckLight}">
                                        <Path x:Name="Tick"
                                              Visibility="Collapsed"
                                              Stretch="Uniform"
                                              Margin="1"
                                              Stroke="White"
                                              StrokeThickness="2"
                                              Data="M 1,2.5 L 3,5 L 7,1" />
                                    </Border>
                                </Border>
                                <TextBlock Text="{TemplateBinding Content}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelTint}" CornerRadius="8" Padding="8" MinWidth="170">
        <StackPanel>
            <TextBlock Text="RESHOT"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="2,0,0,8" />

            <Button x:Name="CaptureBtn" Style="{StaticResource MenuItemButton}" FontWeight="Bold" Content="Capture" />
            <Button x:Name="SettingsBtn" Style="{StaticResource MenuItemButton}" Margin="0,4,0,0" Content="Settings…" />

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleDark}" Margin="0,8,0,0">
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleLight}" />
            </Border>

            <CheckBox x:Name="PauseCheck" Style="{StaticResource MenuCheckBox}" Margin="0,4,0,0" Content="Pause hotkey" />

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleDark}" Margin="0,4,0,0">
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleLight}" />
            </Border>

            <Button x:Name="QuitBtn" Style="{StaticResource MenuItemButton}" Margin="0,8,0,0" Content="Quit" />
        </StackPanel>
    </Border>
</Window>
