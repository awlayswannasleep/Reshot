<Window x:Class="Reshot.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="reshot: Settings"
        Icon="pack://application:,,,/Assets/reshot.ico"
        Width="620" Height="560"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Roboto, Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- ==== Half-Life 2 (Source VGUI) palette · orange #ff9c00 → teal #3C9898 ==== -->
        <SolidColorBrush x:Key="PanelGrey" Color="#FF767676" />
        <SolidColorBrush x:Key="BtnGrey" Color="#FF7B7B7B" />
        <SolidColorBrush x:Key="InputGrey" Color="#FF565656" />
        <SolidColorBrush x:Key="CheckGrey" Color="#FF555555" />
        <SolidColorBrush x:Key="BevelLight" Color="#FFC0BFBF" />
        <SolidColorBrush x:Key="BevelDark" Color="#FF454543" />
        <SolidColorBrush x:Key="InsetDark" Color="#FF343434" />
        <SolidColorBrush x:Key="InsetLight" Color="#FFB7B7B7" />
        <SolidColorBrush x:Key="Ink" Color="#FF000000" />
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextDim" Color="#88FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#FF3C9898" />
        <SolidColorBrush x:Key="AccentBright" Color="#FF54BEBE" />

        <!-- ==== Text ==== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <!-- ==== Raised bevel button (black outline + light TL / dark BR; inverts on press) ==== -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource Ink}" Padding="1">
                            <Grid Background="{StaticResource BtnGrey}">
                                <Border x:Name="Br" BorderBrush="{StaticResource BevelDark}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                                <Border x:Name="Tl" BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource AccentBright}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tl" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Br" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                                <Setter TargetName="Cp" Property="Margin" Value="7,1,5,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}" />

        <!-- ==== Inset text box (dark TL / light BR) ==== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="CaretBrush" Value="{StaticResource TextWhite}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="{StaticResource InputGrey}">
                            <Border BorderBrush="{StaticResource InsetDark}" BorderThickness="1,1,0,0" IsHitTestVisible="False" />
                            <Border BorderBrush="{StaticResource InsetLight}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Checkbox (12px inset box, white tick) ==== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="13" Height="13" VerticalAlignment="Center" Background="{StaticResource CheckGrey}">
                                <Border BorderBrush="#FF424343" BorderThickness="1,1,0,0" />
                                <Border BorderBrush="#FFBABABA" BorderThickness="0,0,1,1" />
                                <Path x:Name="Check" Stretch="Uniform" Margin="2.5"
                                      Stroke="{StaticResource TextWhite}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 0,5 L 3.5,9 L 10,0" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Check" Property="Stroke" Value="{StaticResource AccentBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Slider (inset track, raised handle) ==== -->
        <Style x:Key="TrackRepeat" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="8" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Grid Height="8" VerticalAlignment="Center" Background="{StaticResource InputGrey}">
                                <Border BorderBrush="{StaticResource InsetDark}" BorderThickness="1,1,0,0" />
                                <Border BorderBrush="{StaticResource InsetLight}" BorderThickness="0,0,1,1" />
                            </Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource Ink}" Padding="1">
                                                    <Grid Background="{StaticResource BtnGrey}">
                                                        <Border BorderBrush="{StaticResource BevelDark}" BorderThickness="0,0,1,1" />
                                                        <Border BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== ComboBox (raised button + teal-highlight list) ==== -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{StaticResource Ink}" Padding="1">
                            <Grid Background="{StaticResource BtnGrey}">
                                <Border x:Name="Br" BorderBrush="{StaticResource BevelDark}" BorderThickness="0,0,1,1" />
                                <Border BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" />
                                <Border Width="18" HorizontalAlignment="Right" BorderBrush="{StaticResource BevelDark}" BorderThickness="1,0,0,0">
                                    <Path Data="M 0,0 L 8,0 L 4,4 Z" Fill="{StaticResource TextWhite}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press" />
                            <ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource InputGrey}" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Tabs, HL2 style (light L/T/B, dark R; active drops its bottom border) ==== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="{StaticResource PanelGrey}">
                            <Border x:Name="Light" BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,1" />
                            <Border x:Name="Dark" BorderBrush="{StaticResource BevelDark}" BorderThickness="0,0,1,0" />
                            <ContentPresenter x:Name="Cp" ContentSource="Header" Margin="16,4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Light" Property="BorderThickness" Value="1,1,0,0" />
                                <Setter TargetName="Cp" Property="Margin" Value="16,6,16,5" />
                                <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
                                <Setter Property="Panel.ZIndex" Value="2" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel DockPanel.Dock="Top" Panel.ZIndex="1" IsItemsHost="True" />
                            <Grid Background="{StaticResource PanelGrey}" Margin="0,-1,0,0" MinHeight="300">
                                <Border BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" />
                                <Border BorderBrush="{StaticResource BevelDark}" BorderThickness="0,0,1,1" />
                                <ContentPresenter ContentSource="SelectedContent" Margin="18,16" />
                            </Grid>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ==== Window frame: black outline + raised bevel + grey panel ==== -->
    <Border Background="{StaticResource Ink}" Padding="1">
        <Grid Background="{StaticResource PanelGrey}">
            <Border BorderBrush="{StaticResource BevelDark}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
            <Border BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" IsHitTestVisible="False" />

            <DockPanel Margin="2">
                <!-- Title bar -->
                <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="30">
                    <TextBlock Text="RESHOT · SETTINGS" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="Roboto, Segoe UI" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextWhite}" />
                    <Button x:Name="CloseBtn" Style="{StaticResource Btn}" Content="✕" Width="28" Height="20"
                            MinWidth="28" HorizontalAlignment="Right" Margin="0,0,4,0" FontWeight="Normal" />
                </Grid>

                <!-- Footer -->
                <Grid DockPanel.Dock="Bottom" Height="52">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button x:Name="SaveBtn" Style="{StaticResource PrimaryBtn}" Content="OK" Width="84" Margin="0,0,6,0" />
                        <Button x:Name="CancelBtn" Style="{StaticResource Btn}" Content="Cancel" Width="84" Margin="0,0,6,0" />
                        <Button x:Name="ApplyBtn" Style="{StaticResource Btn}" Content="Apply" Width="84" />
                    </StackPanel>
                </Grid>

                <!-- Tabs -->
                <TabControl Margin="12,6,12,4">

                    <TabItem Header="General">
                        <StackPanel>
                            <TextBlock Text="Capture hotkey" Style="{StaticResource FieldLabel}" />
                            <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HotkeyBox" Grid.Column="0" IsReadOnly="True" Text="Home" />
                                <Button x:Name="RebindBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Rebind" Width="120" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Text="Click Rebind, then press the key combination." />
                            <CheckBox x:Name="AutostartCheck" Content="Start reshot with Windows" Margin="0,14,0,5" />
                            <CheckBox x:Name="UpdateCheck" Content="Install updates automatically" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Overlay">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dim strength" />
                                <Slider x:Name="DimSlider" Grid.Column="1" Minimum="0" Maximum="100" />
                                <TextBlock x:Name="DimValue" Grid.Column="2" Text="50%" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dim color" />
                                <TextBox x:Name="DimColorBox" Grid.Column="1" Text="#000000" />
                                <Border x:Name="DimColorSwatch" Grid.Column="2" Height="22" Margin="8,0,0,0" Background="#FF000000"
                                        BorderBrush="{StaticResource Ink}" BorderThickness="1" />
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Output">
                        <StackPanel>
                            <TextBlock Text="Screenshots folder" Style="{StaticResource FieldLabel}" />
                            <Grid Style="{StaticResource Row}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ScreenshotsBox" Grid.Column="0" />
                                <Button x:Name="BrowseShotsBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…" Width="90" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock Text="Videos folder" Style="{StaticResource FieldLabel}" />
                            <Grid Style="{StaticResource Row}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="VideosBox" Grid.Column="0" />
                                <Button x:Name="BrowseVideosBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…" Width="90" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock Text="Audio recordings folder" Style="{StaticResource FieldLabel}" />
                            <Grid Style="{StaticResource Row}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="RecordsBox" Grid.Column="0" />
                                <Button x:Name="BrowseRecordsBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…" Width="90" Margin="10,0,0,0" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Image format" />
                                <ComboBox x:Name="FormatCombo" Grid.Column="1" HorizontalAlignment="Left" Width="150">
                                    <ComboBoxItem Content="PNG" Tag="png" />
                                    <ComboBoxItem Content="JPG" Tag="jpg" />
                                    <ComboBoxItem Content="WebP" Tag="webp" />
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Quality (JPG/WebP)" />
                                <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="1" Maximum="100" />
                                <TextBlock x:Name="QualityValue" Grid.Column="2" Text="90" Style="{StaticResource ValueText}" />
                            </Grid>
                            <TextBlock Text="Filename template" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox x:Name="FilenameBox" />
                            <TextBlock Style="{StaticResource Hint}" Text="Placeholders:  {date}   {time}" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Video">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Frame rate" />
                                <ComboBox x:Name="FpsCombo" Grid.Column="1" HorizontalAlignment="Left" Width="150">
                                    <ComboBoxItem Content="60 fps" Tag="60" />
                                    <ComboBoxItem Content="30 fps" Tag="30" />
                                    <ComboBoxItem Content="25 fps" Tag="25" />
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="MicCheck" Content="Record microphone" />
                            <CheckBox x:Name="SystemAudioCheck" Content="Record system audio" />
                            <CheckBox x:Name="AskOnSaveCheck" Content="Ask which audio tracks to keep when saving" />
                            <CheckBox x:Name="CornersCheck" Content="Show recording-area corner markers" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Corner color" />
                                <TextBox x:Name="CornerColorBox" Grid.Column="1" Text="#FF0000" />
                                <Border x:Name="CornerColorSwatch" Grid.Column="2" Height="22" Margin="8,0,0,0" Background="#FFFF0000"
                                        BorderBrush="{StaticResource Ink}" BorderThickness="1" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Corner opacity" />
                                <Slider x:Name="CornerOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" />
                                <TextBlock x:Name="CornerOpacityValue" Grid.Column="2" Text="100%" Style="{StaticResource ValueText}" />
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Audio">
                        <StackPanel>
                            <CheckBox x:Name="AudioSystemCheck" Content="Record system audio" />
                            <CheckBox x:Name="AudioMicCheck" Content="Record microphone" />
                            <Grid Style="{StaticResource Row}" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Microphone" />
                                <ComboBox x:Name="MicDeviceCombo" Grid.Column="1" />
                            </Grid>
                            <TextBlock Text="Quick audio-record hotkey (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="AudioHotkeyBox" Grid.Column="0" IsReadOnly="True" />
                                <Button x:Name="AudioRebindBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Rebind" Width="110" Margin="10,0,0,0" />
                                <Button x:Name="AudioClearBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Clear" Width="70" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>
